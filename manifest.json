{
  "manifest_version": 3,
  "name": "TabStick",
  "version": "1.0.0",
  "description": "Sticky notes for every browser tab. Create, pin, and persist notes on any webpage.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "tabGroups"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "assets/icons/icon16.png",
      "48":  "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "TabStick — Sticky Notes"
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "utils/colorThemes.js",
        "utils/storage.js",
        "utils/urlUtils.js",
        "utils/idUtils.js",
        "content/toastManager.js",
        "content/dragHandler.js",
        "content/resizeHandler.js",
        "content/noteRenderer.js",
        "content/noteManager.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "commands": {
    "create-note": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Create a new sticky note on this page"
    },
    "toggle-notes": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Toggle note visibility"
    }
  },

  "icons": {
    "16":  "assets/icons/icon16.png",
    "48":  "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
